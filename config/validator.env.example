# Deployment configuration for a validator unit.
#
#   cp config/validator.env.example config/validator.env
#
# validator.env is git-ignored. Keep it out of the repository: it names the
# production payment endpoint.
#
# These values are the ones the prototype runs with. The prototype still has
# them compiled in; reading them from this file is part of the configuration
# work tracked in docs/ROADMAP.md.

# --- account and paths -------------------------------------------------------

# Unix account the kiosk runs as. Referenced by the systemd unit, the startup
# script and the sudoers fragment.
VALIDATOR_USER=validator
VALIDATOR_HOME=/home/validator

# Where the startup script writes its logs.
VALIDATOR_LOG_DIR=/home/validator/logs

# Named pipe carrying reader events to the user interface. Recreated on every
# start so a stale pipe from a crashed run cannot wedge the next one.
VALIDATOR_FIFO=/tmp/bus_payment_control

# Scratch file the expect script drops the raw card hex into.
VALIDATOR_CARD_DATA=/tmp/card_data_hex.txt

# --- reader ------------------------------------------------------------------

# IDTech SDK demo binary that drives the Kiosk V reader. Shipped with the
# reader's SDK bundle, not part of this repository.
VALIDATOR_IDTECH_DIR=/home/validator/idtech/80144801-001-B/Demo/aarch64

# How long to wait for a tap before restarting the contactless transaction.
VALIDATOR_TAP_TIMEOUT=20

# --- payment backend ---------------------------------------------------------

# Authorisation endpoint. Production value lives in validator.env only.
VALIDATOR_API_URL=https://api.example.invalid/api/v1/payment/card/

# --- user interface ----------------------------------------------------------

# Fare shown on the idle screen.
VALIDATOR_FARE=0.50

# How long a card result stays on screen before returning to idle, in ms.
VALIDATOR_RESULT_TIMEOUT_MS=5000

# Directory holding the idle-screen artwork.
VALIDATOR_ASSETS=/home/validator/assets
