[Unit]
Description=Bus Payment Kiosk Starter
After=network-online.target graphical.target
Wants=network-online.target graphical.target

[Service]
Type=simple
User=validator
WorkingDirectory=/opt/busvalidator
EnvironmentFile=-/opt/busvalidator/config/validator.env
ExecStart=/opt/busvalidator/deploy/scripts/start_all.sh
Restart=always
RestartSec=2
StandardOutput=append:/home/validator/logs/bus-kiosk.service.log
StandardError=append:/home/validator/logs/bus-kiosk.service.log

[Install]
WantedBy=multi-user.target
