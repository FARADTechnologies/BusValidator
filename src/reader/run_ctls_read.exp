#!/usr/bin/expect -f
# cleaned known-good expect script
set timeout -1

# paths from the environment, with the prototype's values as fallback
proc env_or {name fallback} {
    global env
    if {[info exists env($name)] && $env($name) ne ""} { return $env($name) }
    return $fallback
}

set idtech_dir [env_or VALIDATOR_IDTECH_DIR /opt/idtech/80144801-001-B/Demo/aarch64]
set card_data  [env_or VALIDATOR_CARD_DATA /tmp/card_data_hex.txt]
set parser     [env_or VALIDATOR_PARSER /opt/busvalidator/build/parse_card_data]
set tap_wait   [env_or VALIDATOR_TAP_TIMEOUT 20]

# spawn demo inside a shell and set LD_LIBRARY_PATH in that shell
spawn sh -c "cd $idtech_dir && export LD_LIBRARY_PATH=$idtech_dir:\$LD_LIBRARY_PATH && ./IDTechSDK_Demo"

# initial menu picks
expect "Please Input your Selection. (0 - exit current menu)"
send "2\r"

expect "Please Input your Selection. (0 - exit current menu)"
send "1\r"

expect "Please Input your Selection. (0 - exit current menu)"
send "2\r"

# main loop: start CTLS, wait up to 20s for data, parse and call parse_card_data
while {1} {
    send "1\r"
    puts "Start CTLS Trans başlatıldı. Kartı cihaza yaklaştırın..."
    set start_time [clock seconds]
    set found 0

    while {[expr {[clock seconds] - $start_time}] < $tap_wait} {
        expect {
            -re {DFEF4D:\s*([0-9A-Fa-f]+)} {
                set hex_data $expect_out(1,string)
                puts "DFEF4D verisi alındı ([string length $hex_data] karakter)"
                set fp [open $card_data "w"]
                puts $fp $hex_data
                close $fp
                exec $parser &
                set found 1
                break
            }
            -re {C1DFEE([0-9A-Fa-f]+)} {
                set hex_data $expect_out(0,string)
                puts "C1DFEE verisi alındı ([string length $hex_data] karakter)"
                set fp [open $card_data "w"]
                puts $fp $hex_data
                close $fp
                exec $parser &
                set found 1
                break
            }
            -re {Please Tap Card.*} {
                exp_continue
            }
            timeout 1 { }
        }
    }

    # cancel transaction (safe) then loop again
    send "2\r"

    if {$found == 1} {
        puts "Kart verisi kaydedildi."
    } else {
        puts "Kart okunamadı, zaman aşımı!"
    }
    sleep 1
}
